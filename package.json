{
  "name": "mac-insomnia",
  "version": "1.0.15",
  "description": "Mac Insomnia",
  "main": "main/main.js",
  "scripts": {
    "start": "electron . 2>/dev/null",
    "build": "electron-builder",
    "test": "node --test",
    "measure": "node scripts/measure-footprint.mjs"
  },
  "keywords": [],
  "author": "Ariel Benesh",
  "license": "MIT",
  "build": {
    "appId": "com.nodomain.insomnia",
    "productName": "Mac Insomnia",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "build/icon.icns",
      "package.json"
    ],
    "asarUnpack": [
      "assets",
      "renderer"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "relbns",
        "repo": "mac-insomnia",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "Mac Insomnia",
        "schemes": [
          "mac-insomnia"
        ]
      }
    ],
    "afterPack": "build/after-pack.js"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relbns/mac-insomnia.git"
  },
  "bugs": {
    "url": "https://github.com/relbns/mac-insomnia/issues"
  },
  "homepage": "https://github.com/relbns/mac-insomnia#readme"
}
