{
  "name": "mac-insomnia",
  "version": "1.0.2",
  "description": "Mac Insomnia",
  "main": "main/main.js",
  "scripts": {
    "start": "electron . 2>/dev/null",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "Ariel Benesh",
  "license": "ISC",
  "build": {
    "appId": "com.nodomain.insomnia",
    "productName": "Mac Insomnia",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "build/icon.icns",
      "package.json"
    ],
    "asarUnpack": [
  "assets",
  "renderer"
]
  },
  "devDependencies": {
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relbns/mac-insomnia.git"
  },
  "bugs": {
    "url": "https://github.com/relbns/mac-insomnia/issues"
  },
  "homepage": "https://github.com/relbns/mac-insomnia#readme"
}